# Copie este arquivo para .env.local e preencha.

# String de conexao do Postgres.
# No Supabase: Project Settings > Database > Connection string > "Connection pooling"
# IMPORTANTE: use a porta 6543 (pooler), nao a 5432. Em serverless a 5432 esgota conexoes.
DATABASE_URL="postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Senha para entrar no painel do professor (/professor). Escolha uma e nao compartilhe com alunos.
SENHA_PROFESSOR="troque-esta-senha"
